{
  "name": "council-review",
  "version": "0.2.0",
  "description": "A read-only, multi-vendor code review panel over local git state.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ad-005/council-review.git"
  },
  "bugs": {
    "url": "https://github.com/ad-005/council-review/issues"
  },
  "homepage": "https://github.com/ad-005/council-review#readme",
  "author": {
    "name": "Antonije D.",
    "url": "https://github.com/ad-005"
  },
  "keywords": [
    "code-review",
    "cli",
    "git",
    "multi-model",
    "llm",
    "ai-review",
    "static-analysis",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "council-review": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --project unit --project security",
    "test:unit": "vitest run --project unit",
    "test:security": "vitest run --project security",
    "test:live": "COUNCIL_LIVE=1 vitest run --project live"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.1",
    "@sinclair/typebox": "^0.34.14",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^5.0.0"
  }
}
